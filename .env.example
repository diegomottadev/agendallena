APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# RNF-02 · La aplicacion corre en UTC siempre. La zona del negocio vive en
# `tenants.timezone` y solo se aplica al mostrar: nunca al guardar.
APP_TIMEZONE=UTC


APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4, no sqlite: el esquema usa columnas generadas (`bookings.live_event_id`)
# y ENUM, y los tests de husos dependen de la tzdata de la imagen. Los hosts son
# los nombres de servicio de `docker-compose.yml`, no 127.0.0.1: todo corre dentro
# de la red del compose.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=agendallena
DB_USERNAME=agendallena
DB_PASSWORD=secret

# La suite corre contra su propia base, creada por `docker/mysql/init/`. El nombre
# lo fija `phpunit.xml`; host y credenciales se heredan de las de arriba.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Meta Cloud API (T-001, T-008, T-010) ---
# Datos publicos: se pueden versionar en .env.example
META_APP_ID=
META_WABA_ID=
META_PHONE_NUMBER_ID=
# Secretos: NUNCA al repositorio. .env esta en .gitignore.
META_APP_SECRET=
META_ACCESS_TOKEN=
# Lo elegimos nosotros, no lo da Meta. Va tambien en el formulario del portal.
META_VERIFY_TOKEN=

# Google Calendar · T-012. El consentimiento se pide una vez por PyME desde el
# panel; los tokens quedan encriptados en `integrations`, nunca en el entorno.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/oauth/google/callback
